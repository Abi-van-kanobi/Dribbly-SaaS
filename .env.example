# Copy to .env and fill in. Never commit .env.

# Database. SQLite for local dev; Phase 1B switches to Postgres (Neon).
DATABASE_URL="file:./dev.db"

# Signs login cookies. Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Google sign-in (Google Cloud Console > Credentials > OAuth client ID, type Web).
# Authorised redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public origin of the app, used to build the Google redirect URI.
APP_URL="http://localhost:3000"

# Shared demo login for the marketing site. On by default in dev, off in production.
DEMO_ENABLED="true"

# Local-only fake Google sign-in for testing onboarding without Google keys.
# Ignored when NODE_ENV=production. Leave unset anywhere real.
ALLOW_DEV_LOGIN=""

# File storage for the Work Aligner. Unset in development = a local .storage folder.
# Production needs STORAGE_DRIVER="r2" and the four R2 values below (see README, "File storage").
STORAGE_DRIVER=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Set to "eu" ONLY if the bucket was created in the EU jurisdiction (it cannot be changed afterwards).
R2_JURISDICTION=""
# Total uploaded megabytes one workspace may store. Default 1024. Set with pricing.
ALIGNER_WORKSPACE_LIMIT_MB=""
